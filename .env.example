# Required
SECRET_KEY=replace-me-with-a-random-string
BASE_URL=http://localhost:5000

# Demo Mode (set to true for read-only portfolio deployment)
DEMO_MODE=false

# University Domains (comma-separated). Set FEATURE_MULTI_UNIVERSITY=true for multi-campus support.
ALLOWED_UNIVERSITY_DOMAINS=brookes.ac.uk
FEATURE_MULTI_UNIVERSITY=false

# Database (SQLite default in dev; PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/reuni

# Brevo Email API (transactional emails, OTP verification)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@reuni.uk
BREVO_SENDER_NAME=Reuni
MAIL_TIMEOUT=30

# Storage Provider (local for offline dev, r2 for Cloudflare R2 production)
STORAGE_PROVIDER=local

# Cloudflare R2 Configuration (required only if STORAGE_PROVIDER=r2)
# CF_R2_ACCESS_KEY_ID=your-r2-access-key-id
# CF_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# CF_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# CF_R2_BUCKET_NAME=reuni-uploads
# CF_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Cloudflare Turnstile CAPTCHA (optional, falls back to test dummy keys in dev)
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
