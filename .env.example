# Copy this file to .env and fill in your values
SECRET_KEY=replace-me-with-a-random-string
DATABASE_URL=sqlite:///unicycle.db

# Flask-Mail configuration for email verification
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=support@unicycle.ac.uk

# Set of university domains permitted to register (comma-separated). Empty = allow all .ac.uk
ALLOWED_UNIVERSITY_DOMAINS=brookes.ac.uk
